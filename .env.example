AI_ENABLED=false
# Use fresh keys. Never commit .env or paste keys into chat.
TYPESAFE_API_KEY=
MISTRAL_API_KEY=
JEV_MODEL=jev-1.14.0
MISTRAL_MODEL=mistral-large-4-0
JEV_CONFIDENCE_THRESHOLD=0.8
# Default is a local SQLite MLflow store. Do not point this at a public server.
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Optional external observability: only metadata is sent, never prompts/results.
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vibe-inventory
# PDF RAG: use a fresh key in ignored .env, then run python -m backend.services.ai_rag index.
QDRANT_URL=https://16723db5-daa5-4e68-ab07-3135bfe9bfef.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION_ALIAS=vibe-inventory-faq
MISTRAL_EMBEDDING_MODEL=mistral-embed
